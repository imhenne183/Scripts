local DefaultAmbient = Lighting.Ambient
local DefaultBrightness = Lighting.Brightness

CameraSection:Toggle({
    Title = "Fullbright",
    Desc = "Removes shadows and dark lighting across the map",
    Value = false,
    Callback = function(state)
        Settings.Fullbright = state
        if state then
            Lighting.Ambient = Color3.fromRGB(255, 255, 255)
            Lighting.Brightness = 2
            Lighting.GlobalShadows = false
        else
            Lighting.Ambient = DefaultAmbient
            Lighting.Brightness = DefaultBrightness
            Lighting.GlobalShadows = true
        end
    end
})

local ESPSection = VisualsTab:Section({
    Title = "Player Highlights (ESP)",
    Opened = true,
})

local Highlights = {}

local function updateESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local existing = plr.Character:FindFirstChild("VeloixHighlight")
            if Settings.ESPEnabled then
                if not existing then
                    local hl = Instance.new("Highlight")
                    hl.Name = "VeloixHighlight"
                    hl.FillColor = Settings.ESPColor
                    hl.OutlineColor = Color3.new(1, 1, 1)
                    hl.FillTransparency = 0.5
                    hl.Parent = plr.Character
                    Highlights[plr] = hl
                else
                    existing.FillColor = Settings.ESPColor
                end
            elseif existing then
                existing:Destroy()
                Highlights[plr] = nil
            end
        end
    end
end

ESPSection:Toggle({
    Title = "Enable Player Highlight",
    Desc = "Highlights all players through walls",
    Value = false,
    Callback = function(state)
        Settings.ESPEnabled = state
        updateESP()
    end
})

ESPSection:Colorpicker({
    Title = "Highlight Color",
    Desc = "Change the fill color of player highlights",
    Default = Settings.ESPColor,
    Callback = function(color)
        Settings.ESPColor = color
        updateESP()
    end
})

