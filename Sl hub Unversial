local function RemoveVisuals(target)
    if not target.Character then
        return
    end

    local highlight =
        target.Character:FindFirstChild("SlHighlight")

    if highlight then
        highlight:Destroy()
    end

    local head =
        target.Character:FindFirstChild("Head")

    if head then
        local billboard =
            head:FindFirstChild("SlInfo")

        if billboard then
            billboard:Destroy()
        end
    end
end

local function UpdateVisuals(target)
    if target == Player then
        return
    end

    local char = target.Character

    if not char then
        return
    end

    local head = char:FindFirstChild("Head")

    local targetRoot =
        char:FindFirstChild("HumanoidRootPart")

    if ESPEnabled then
        if not char:FindFirstChild("slHighlight") then
            local highlight = Instance.new("Highlight")

            highlight.Name = "SlHighlight"
            highlight.FillTransparency = 0.8
            highlight.OutlineTransparency = 0
            highlight.DepthMode =
                Enum.HighlightDepthMode.AlwaysOnTop

            highlight.Parent = char
        end
    else
        local highlight =
            char:FindFirstChild("SlHighlight")

        if highlight then
            highlight:Destroy()
        end
    end

    if head and (NameESPEnabled or DistanceESPEnabled) then
        local billboard =
            head:FindFirstChild("EncryptedInfo")

        if not billboard then
            billboard = Instance.new("BillboardGui")
            billboard.Name = "SlInfo"
            billboard.Size = UDim2.fromOffset(200, 40)
            billboard.StudsOffset = Vector3.new(0, 2.7, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = head

            local label = Instance.new("TextLabel")
            label.Name = "Label"
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextStrokeTransparency = 0
            label.TextSize = 14
            label.Parent = billboard
        end

        local label =
            billboard:FindFirstChild("Label")

        if label then
            local text = ""

            if NameESPEnabled then
                text = target.DisplayName
            end

            if DistanceESPEnabled
                and Root()
                and targetRoot then

                local distance = math.floor(
                    (
                        Root().Position -
                        targetRoot.Position
                    ).Magnitude
                )

                if text ~= "" then
                    text ..= " | "
                end

                text ..= tostring(distance) .. " studs"
            end

            label.Text = text
        end
    elseif head then
        local billboard =
            head:FindFirstChild("EncryptedInfo")

        if billboard then
            billboard:Destroy()
        end
    end
end

local function GetClosestTarget()
    local closest = nil
    local closestDistance = AimFOV

    local mouse =
        UserInputService:GetMouseLocation()

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local hum =
                target.Character:FindFirstChildOfClass(
                    "Humanoid"
                )

            local part =
                target.Character:FindFirstChild(AimPart)

            if hum and hum.Health > 0 and part then
                local position, visible =
                    Camera:WorldToViewportPoint(
                        part.Position
                    )

                if visible then
                    local distance =
                        (
                            Vector2.new(
                                position.X,
                                position.Y
                            ) - mouse
                        ).Magnitude

                    if distance < closestDistance then
                        closestDistance = distance
                        closest = target
                    end
                end
            end
        end
    end

    return closest
end

local function AimAt(target, instant)
    if not target or not target.Character then
        return
    end

    local part =
        target.Character:FindFirstChild(AimPart)

    if not part then
        return
    end

    local goal =
        CFrame.lookAt(
            Camera.CFrame.Position,
            part.Position
        )

    if instant then
        Camera.CFrame = goal
    else
        Camera.CFrame =
            Camera.CFrame:Lerp(
                goal,
                AimSmoothness
            )
    end
end

