local function Notify(title, content)
    WindUI:Notify({
        Title = title,
        Content = content,
        Duration = 3
    })
end

local function Character()
    return Player.Character
end

local function Humanoid()
    local char = Character()

    if char then
        return char:FindFirstChildOfClass("Humanoid")
    end
end

local function Root()
    local char = Character()

    if char then
        return char:FindFirstChild("HumanoidRootPart")
    end
end

local function ServerCommand(command, args)
    if not Remote then
        Notify(
            "Sl Hub",
            "CommandRemote is not installed."
        )

        return
    end

    Remote:FireServer(command, args or {})
end

local function FindPlayer(text)
    text = string.lower(text or "")

    if text == "" then
        return nil
    end

    for _, target in ipairs(Players:GetPlayers()) do
        if string.sub(
            string.lower(target.Name),
            1,
            #text
        ) == text then
            return target
        end

        if string.sub(
            string.lower(target.DisplayName),
            1,
            #text
        ) == text then
            return target
        end
    end
end

