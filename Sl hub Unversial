Main:Input({
    Title = "Command",
    Desc = "Example: speed 50",
    Placeholder = "Enter command...",

    Callback = function(text)
        if not text or text == "" then
            return
        end

        if string.sub(text, 1, 1) == ";" then
            text = string.sub(text, 2)
        end

        local args = string.split(text, " ")
        local command = string.lower(args[1] or "")

        table.remove(args, 1)

        if command == "speed" then
            local hum = Humanoid()

            if hum then
                hum.WalkSpeed = math.clamp(
                    tonumber(args[1]) or 16,
                    0,
                    250
                )
            end

        elseif command == "jump" then
            local hum = Humanoid()

            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = math.clamp(
                    tonumber(args[1]) or 50,
                    0,
                    250
                )
            end

        elseif command == "fov" then
            Camera.FieldOfView = math.clamp(
                tonumber(args[1]) or 70,
                20,
                120
            )

        elseif command == "fullbright" then
            Lighting.Brightness = 2
            Lighting.ClockTime = 14
            Lighting.FogEnd = 100000

        elseif command == "goto" then
            local target = FindPlayer(args[1])

            if target and target.Character and Root() then
                local targetRoot =
                    target.Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if targetRoot then
                    Root().CFrame =
                        targetRoot.CFrame *
                        CFrame.new(3, 0, 0)
                end
            end

        elseif command == "esp" then
            ESPEnabled = true

        elseif command == "unesp" then
            ESPEnabled = false

        elseif command == "aimbot" then
            AimbotEnabled = true

        elseif command == "unaimbot" then
            AimbotEnabled = false

        else
            ServerCommand(command, args)
        end

        Notify(
            "SL Hub",
            "Executed: " .. command
        )
    end
})

